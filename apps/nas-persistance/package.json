    "@melchor629/infra": "*",
    "@melchor629/prisma-nas-auth": "*",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/instrumentation": "^7.9.1",
    "dataloader": "^2.2.3",
    "fastify": "^5.11.3",
    "graphql": "^16.14.2",
    "graphql-constraint-directive": "^6.0.0",
    "graphql-tag": "^2.12.7",
    "graphql-scalars": "^1.25.0",
    "jose": "^6.2.8"

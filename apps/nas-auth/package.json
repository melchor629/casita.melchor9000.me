{
  "name": "nas-auth",
  "private": true,
  "version": "3.3.0",
  "description": "OIDC and Authorization server",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists .env ./dist/server.ts",
    "dev": "NODE_ENV=development node --env-file-if-exists=.env src/index.ts",
    "build": "vite build --app",
    "lint": "eslint src",
    "check": "tsc -p . --noEmit",
    "docker": "../../docker_build.sh",
    "gql": "graphql-codegen-esm --config ./src/queries/client/config.ts"
  },
  "author": "melchor9000",
  "license": "ISC",
  "bin": {
    "nas-auth": "./src/index.ts",
    "nas-auth-generate-jwks": "./src/generate-keys.js"
  },
  "imports": {
    "#actions/*": "./src/app/actions/*",
    "#components/*": "./src/app/components/*",
    "#queries/*": "./src/queries/*"
  },
  "dependencies": {
    "@fastify/caching": "^9.0.3",
    "@fastify/cookie": "^11.1.1",
    "@fastify/formbody": "^8.0.2",
    "@fastify/middie": "^9.3.3",
    "@fastify/oauth2": "^8.2.0",
    "@fastify/otel": "^0.20.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/session": "^11.1.1",
    "@floating-ui/react": "^0.27.19",
    "@fortawesome/fontawesome-svg-core": "^7.3.0",
    "@fortawesome/free-brands-svg-icons": "^7.3.0",
    "@fortawesome/react-fontawesome": "^3.4.0",
    "@melchor629/fastify-infra": "*",
    "@melchor629/infra": "*",
    "@melchor629/ui": "*",
    "@melchor629/nice-ssr": "*",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@tanstack/react-query": "^5.101.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/instrumentation-redis": "^0.68.0",
    "clsx": "^2.1.1",
    "connect-redis": "^9.0.0",
    "fastify": "^5.10.0",
    "fastify-plugin": "^5.1.0",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "jose": "^6.2.3",
    "motion": "^12.42.2",
    "nanoid": "^5.1.16",

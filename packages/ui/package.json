{
  "name": "@melchor629/ui",
  "private": true,
  "version": "0.0.3",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./utils": "./src/utils.tsx",
    "./styles": "./styles/tailwind.css",
    "./styles/manual-theme": "./styles/manual-theme.css",
    "./*": "./src/*/index.ts"
  },
  "scripts": {
    "lint": "eslint src .storybook",
    "check": "tsc -p . --noEmit",
    "build": "bun run ./generate-index.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@fontsource-variable/material-symbols-outlined": "^5.0.0",
    "@fortawesome/fontawesome-free": "^7.0.0",
    "clsx": "^2.0.0",
    "tailwind-variants": "^3.0.0"
  },
  "peerDependencies": {
    "@floating-ui/react": "^0.27.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@floating-ui/react": {
      "optional": true
    },
    "react-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@melchor629/tsconfigs": "*",
    "@storybook/addon-a11y": "^10.2.15",
    "@storybook/addon-docs": "^10.2.15",
    "@storybook/addon-themes": "^10.2.15",
    "@storybook/addon-vitest": "^10.2.15",
    "@storybook/react-vite": "^10.2.15",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react": "^19.0.0",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint-plugin-storybook": "^10.2.15",
    "playwright": "^1.58.2",
    "storybook": "^10.2.15",
    "tailwindcss": "^4.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.18"
  }
}

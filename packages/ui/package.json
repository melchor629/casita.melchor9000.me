{
  "name": "@melchor629/ui",
  "version": "0.0.8",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/test-utils": "./src/test-utils.tsx",
    "#*": [
      "./*",
      "./*.ts",
      "./*.tsx",
      "./*.js",
      "./*.jsx"
    ]
  },
  "exports": {
    ".": "./src/index.ts",
    "./utils": "./src/utils.tsx",
    "./styles": "./styles/tailwind.css",
    "./styles/manual-theme": "./styles/manual-theme.css",
    "./*": "./src/*/index.ts"
  },
  "scripts": {
    "check:lint": "oxlint",
    "check:fmt": "oxfmt --check",
    "check:ts": "tsc -p . --noEmit",
    "build-index": "bun run ./generate-index.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@fontsource-variable/material-symbols-outlined": "^5.3.9",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "clsx": "^2.1.1",
    "tailwind-variants": "^4.0.2"
  },
  "devDependencies": {
    "@melchor629/tsconfigs": "*",
    "@storybook/addon-a11y": "^11.0.0-beta.3",
    "@storybook/addon-docs": "^11.0.0-beta.3",
    "@storybook/addon-mcp": "^11.0.0-beta.3",
    "@storybook/addon-themes": "^11.0.0-beta.3",
    "@storybook/addon-vitest": "^11.0.0-beta.3",
    "@storybook/react-vite": "^11.0.0-beta.3",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint-plugin-storybook": "^11.0.0-beta.3",
    "playwright": "^1.65.0",
    "storybook": "^11.0.0-beta.3",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vitest-browser-react": "^2.3.0"
  },
  "peerDependencies": {
    "@floating-ui/react": "^0.27.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "peerDependenciesMeta": {
    "@floating-ui/react": {
      "optional": true
    },
    "react-router": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}

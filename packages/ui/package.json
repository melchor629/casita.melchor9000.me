{
  "name": "@melchor629/ui",
  "private": true,
  "version": "0.0.4",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./utils": "./src/utils.tsx",
    "./styles": "./styles/tailwind.css",
    "./styles/manual-theme": "./styles/manual-theme.css",
    "./*": "./src/*/index.ts"
  },
  "scripts": {
    "lint": "eslint src .storybook",
    "check": "tsc -p . --noEmit",
    "build": "bun run ./generate-index.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@fontsource-variable/material-symbols-outlined": "^5.3.6",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "clsx": "^2.1.1",
    "tailwind-variants": "^3.3.1"
  },
  "peerDependencies": {
    "@floating-ui/react": "^0.27.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.3.1"
  },
  "peerDependenciesMeta": {
    "@floating-ui/react": {
      "optional": true
    },
    "react-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@melchor629/tsconfigs": "*",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-themes": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/react": "^19.3.0",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint-plugin-storybook": "^10.6.0",
    "playwright": "^1.63.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}

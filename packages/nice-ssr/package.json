{
  "name": "@melchor629/nice-ssr",
  "version": "0.6.6",
  "private": true,
  "files": [
    "bin/",
    "dist/",
    "src/nice-ssr/"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./vite": {
      "types": "./dist/vite/plugin.d.ts",
      "import": "./dist/vite/plugin.js"
    },
    "./fastify": {
      "types": "./dist/fastify/plugin.d.ts",
      "import": "./dist/fastify/plugin.js"
    },
    "./server": {
      "types": "./dist/entry/server.d.tsx",
      "import": "./dist/entry/server.js"
    },
    "./server.js": {
      "import": "./dist/entry/server.js"
    },
    ".": {
      "types": "./dist/nice-ssr/nice-ssr.d.ts",
      "import": "./dist/nice-ssr/nice-ssr.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p .",
    "dev": "tsc -p . --watch",
    "check:lint": "oxlint",
    "check:fmt": "oxfmt --check",
    "check:ts": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "astring": "^1.9.0",
    "fastify-plugin": "^6.0.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@fastify/middie": "^9.3.6",
    "@melchor629/tsconfigs": "*",
    "@types/estree": "^1.0.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "vite": "^8.3.8"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.10.0",
    "fastify": "^5.12.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.8"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}

{
  "name": "@melchor629/nice-ssr",
  "private": true,
  "version": "0.5.2",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./vite": {
      "types": "./dist/vite/plugin.d.ts",
      "import": "./dist/vite/plugin.js"
    },
    "./fastify": {
      "types": "./dist/fastify/plugin.d.ts",
      "import": "./dist/fastify/plugin.js"
    },
    "./server": {
      "types": "./dist/entry/server.d.tsx",
      "import": "./dist/entry/server.js"
    },
    "./server.js": {
      "import": "./dist/entry/server.js"
    },
    ".": {
      "types": "./dist/nice-ssr/nice-ssr.d.ts",
      "import": "./dist/nice-ssr/nice-ssr.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p .",
    "dev": "tsc -p . --watch",
    "lint": "eslint src",
    "check": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^9.3.0",
    "astring": "^1.9.0",
    "fastify-plugin": "^5.1.0",
    "zustand": "^5.0.14"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "fastify": "^5.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^8.0.5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fastify/middie": "^9.3.3",
    "@melchor629/tsconfigs": "*",
    "@types/estree": "^1.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.0",
    "vite": "^8.1.4"
  },
  "files": [
    "bin/",
    "dist/",
    "src/nice-ssr/"
  ]
}

{
  "name": "casita.melchor9000.me",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dedupe": "bunlock-dedupe --update --fix && bun i",
    "dev": "turbo run dev",
    "change": "changeset",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "docker": "turbo run docker --concurrency 1 --ui stream --log-prefix=none",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:deploy": "turbo run deploy"
  },
  "packageManager": "bun@1.3.0",
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@melchor629/eslint-config": "^0.4.1",
    "@types/node": "^24.13.1",
    "bunlock-dedupe": "^1.8.2",
    "eslint": "^9.39.4",
    "typescript": "^6.0.3",
    "turbo": "^2.10.9"
  }
}

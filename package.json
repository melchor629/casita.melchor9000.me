{
  "name": "casita.melchor9000.me",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "change": "changeset",
    "check": "oxlint && oxfmt --check",
    "lint": "turbo run lint",
    "docker": "turbo run docker --concurrency 1 --ui stream --log-prefix=none",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:deploy": "turbo run deploy"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@melchor629/oxfmt-config": "^0.1.0",
    "@melchor629/oxlint-config": "^0.1.2",
    "@types/node": "^26.6.11",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2009",
    "turbo": "^2.11.13",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.4.0"
}
